<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Game Hub</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #1a1a2e;
            color: #fff;
            margin: 0;
            padding: 20px;
        }
        h1 {
            text-align: center;
        }
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            max-width: 1000px;
            margin: 0 auto;
        }
        .game-card {
            background: #16213e;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            border: 1px solid #0f3460;
        }
        .game-card a {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 16px;
            background: #e94560;
            color: #fff;
            text-decoration: none;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <h1>Game Collection</h1>

    <div class="game-grid">
        <div class="game-card">
            <h3>Game Title 1</h3>
            <p>Short description of the game.</p>
            <a href="game1.html">Play Game</a>
        </div>
        <div class="game-card">
            <h3>Game Title 2</h3>
            <p>Short description of the game.</p>
            <a href="game2.html">Play Game</a>
        </div>
    </div>

</body>
</html>
